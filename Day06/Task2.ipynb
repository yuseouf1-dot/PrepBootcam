   "source": [
    "def func_rec(num):\n",
    "    result = 1\n",
    "    for i in range(num):\n",
    "        result *= i\n",
    "    return result\n",
    "\n",
    "input_num = int(input())\n",
    "func_rec(input_num)\n"
   ]
  }
